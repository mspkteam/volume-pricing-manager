# Volume Pricing Manager — environment example (no secrets)

# Shopify app credentials (from Partner Dashboard / `shopify app env`)
SHOPIFY_API_KEY=97480e97d6bd60193b5e48196127411a
SHOPIFY_API_SECRET=
SCOPES=read_customers,write_customers,read_orders,read_products,write_discounts,read_discounts,write_products
# After Shopify approves "read all orders", append: ,read_all_orders
SHOPIFY_APP_URL=https://volume-pricing-manager.vercel.app

# PostgreSQL (required for production persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/volume_pricing_manager?schema=public

# Worker
WORKER_POLL_MS=2000

# Pricing integration — keep false until distribution/plan verified and Function deployed
# Custom apps need Shopify Plus for Functions; App Store apps can use Functions on all plans.
PRICING_WRITES_ENABLED=false
SHOPIFY_APP_DISTRIBUTION=custom
# unknown | app_store | custom

# Optional branding override (also configurable in Settings)
APP_DISPLAY_NAME=Volume Pricing Manager

# Node
NODE_ENV=development
PORT=3000

# --- App proxy (storefront forms) ---
# shopify.app.toml [app_proxy] should point url at ${SHOPIFY_APP_URL}/proxy
# Storefront paths: /apps/volume-pricing/forms/{handle}
#                   /apps/volume-pricing/forms/{handle}/submit
#                   /apps/volume-pricing/forms/{handle}/upload
#                   /apps/volume-pricing/account/status
# Shopify signs logged_in_customer_id on proxy requests — never invent customer IDs.

# --- Private file uploads (forms) ---
# Required for file_upload fields. Until configured, those fields surface a setup message.
# UPLOAD_STORAGE_PROVIDER=s3|r2|memory|dev
# memory|dev only for local non-production (or ALLOW_DEV_UPLOADS=true)
UPLOAD_STORAGE_PROVIDER=
UPLOAD_BUCKET=
UPLOAD_ACCESS_KEY_ID=
UPLOAD_SECRET_ACCESS_KEY=
# Optional for S3-compatible / R2
UPLOAD_ENDPOINT=
UPLOAD_PUBLIC_BASE_URL=
# Signed PUT/GET gateway for production object storage
UPLOAD_PUT_BASE_URL=
UPLOAD_GET_BASE_URL=
UPLOAD_PUT_TOKEN=
ALLOW_DEV_UPLOADS=false
