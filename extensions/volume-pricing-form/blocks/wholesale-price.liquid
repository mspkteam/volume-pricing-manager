{% comment %}
  Legacy alias — prefer “VPM product price” / “VPM card price”.
  Uses closest.product so it works on PDP and product cards.
{% endcomment %}
{% liquid
  assign vpm_product = closest.product
  if vpm_product == blank
    assign vpm_product = product
  endif
  if vpm_product == blank and block.settings.product != blank
    assign vpm_product = block.settings.product
  endif
%}

<div
  class="vpm-tier-price-block"
  style="
    --vpm-text: {{ block.settings.text_color }};
    --vpm-accent: {{ block.settings.accent_color }};
    margin-block: {{ block.settings.spacing }}px;
  "
  {{ block.shopify_attributes }}
>
  {% render 'vpm-tier-price',
    vpm_product: vpm_product,
    compact: false,
    show_badge: true,
    show_hint: block.settings.show_hint,
    pending_message: block.settings.pending_message
  %}
</div>

{% schema %}
{
  "name": "VPM wholesale price",
  "target": "section",
  "stylesheet": "vpm-price.css",
  "templates": ["product", "index", "page", "collection", "cart", "search"],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product (optional fallback)"
    },
    {
      "type": "checkbox",
      "id": "show_hint",
      "label": "Show hint",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0b5fff"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Spacing",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "text",
      "id": "pending_message",
      "label": "Logged-in without approval",
      "default": "Your wholesale application is pending approval or has no active tier yet."
    },
    {
      "type": "text",
      "id": "approved_no_tier_message",
      "label": "Approved but no % tier yet",
      "default": "You're approved. Tier pricing will appear once a volume tier is assigned."
    },
    {
      "type": "url",
      "id": "apply_url",
      "label": "Apply link"
    }
  ]
}
{% endschema %}
