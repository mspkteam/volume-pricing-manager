{% comment %}
  Volume Pricing Form — app block widget.
  Merchant pastes Form ID (or handle) from the app → Forms → Embed.
{% endcomment %}

{% liquid
  assign form_key = block.settings.form_id | strip
  if form_key == blank
    assign form_key = block.settings.form_handle | strip
  endif
  assign scope_id = block.id | replace: '/', '_'
%}

<div
  id="vpm-form-{{ scope_id }}"
  class="vpm-form vpm-form--{{ block.settings.button_style }} vpm-form-spacing-{{ block.settings.section_spacing }}"
  data-vpm-form
  data-block-id="{{ block.id }}"
  data-form-id="{{ form_key | escape }}"
  data-form-handle="{{ form_key | escape }}"
  data-proxy-base="/apps/volume-pricing/forms/{{ form_key | url_encode }}"
  data-show-heading="{{ block.settings.show_heading }}"
  data-show-description="{{ block.settings.show_description }}"
  style="
    --vpm-heading: {{ block.settings.heading_color }};
    --vpm-text: {{ block.settings.text_color }};
    --vpm-btn-bg: {{ block.settings.button_background }};
    --vpm-btn-text: {{ block.settings.button_text_color }};
  "
  {{ block.shopify_attributes }}
>
  {% if form_key == blank %}
    <p class="vpm-form__setup">
      Add your <strong>Form ID</strong> in the block settings (App → Forms → Embed).
    </p>
  {% else %}
    <div class="vpm-form__loading" data-vpm-loading>Loading form…</div>
    <div class="vpm-form__error" data-vpm-error hidden></div>
    <div class="vpm-form__success" data-vpm-success hidden></div>
    <form class="vpm-form__body" data-vpm-body hidden novalidate>
      <div data-vpm-steps></div>
      <div class="vpm-form__nav" data-vpm-nav>
        <button type="button" class="vpm-form__btn vpm-form__btn--secondary" data-vpm-prev hidden>Back</button>
        <button type="button" class="vpm-form__btn" data-vpm-next hidden>Continue</button>
        <button type="submit" class="vpm-form__btn" data-vpm-submit>Submit</button>
      </div>
    </form>
  {% endif %}
</div>

{% schema %}
{
  "name": "Volume Pricing Form",
  "target": "section",
  "stylesheet": "vpm-form.css",
  "templates": ["index", "page", "product", "collection", "blog", "article", "cart", "list-collections", "search", "404"],
  "settings": [
    {
      "type": "text",
      "id": "form_id",
      "label": "Form ID",
      "info": "Paste the Form ID from the app (Forms → Embed). Handle also works."
    },
    {
      "type": "text",
      "id": "form_handle",
      "label": "Form handle (legacy)",
      "info": "Optional fallback if Form ID is empty."
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show form title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show form description",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "default", "label": "Default" },
        { "value": "relaxed", "label": "Relaxed" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    }
  ]
}
{% endschema %}
